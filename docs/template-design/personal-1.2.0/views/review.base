filters:
  and:
    - 'file.inFolder("knowledge")'
    - 'file.ext == "md"'
formulas:
  attention: 'if(lifecycle == "disputed", "disputed", if(valid_until && date(valid_until) < today(), "expired", if(review_after && date(review_after) <= today(), "review due", "")))'
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  type:
    displayName: Type
  lifecycle:
    displayName: Lifecycle
  valid_until:
    displayName: Valid until
  review_after:
    displayName: Review after
  formula.attention:
    displayName: Attention
  updated_at:
    displayName: Updated
views:
  - type: table
    name: Needs review
    filters:
      or:
        - 'lifecycle == "disputed"'
        - 'valid_until && date(valid_until) < today()'
        - 'review_after && date(review_after) <= today()'
    groupBy:
      property: formula.attention
      direction: ASC
    order:
      - file.name
      - title
      - type
      - lifecycle
      - formula.attention
      - valid_until
      - review_after
      - updated_at
  - type: table
    name: Inactive knowledge
    filters:
      or:
        - 'lifecycle == "superseded"'
        - 'lifecycle == "retracted"'
    groupBy:
      property: lifecycle
      direction: ASC
    order:
      - file.name
      - title
      - type
      - lifecycle
      - superseded_by
      - updated_at
