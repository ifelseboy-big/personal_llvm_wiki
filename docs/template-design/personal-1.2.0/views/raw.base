filters:
  and:
    - 'file.inFolder("raw")'
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  type:
    displayName: Type
  origin:
    displayName: Origin
  description:
    displayName: Description
  captured_at:
    displayName: Captured
  source_url:
    displayName: Source URL
  authors:
    displayName: Authors
  source_date:
    displayName: Source date
  retrieved_at:
    displayName: Retrieved
  tags:
    displayName: Tags
views:
  - type: table
    name: Raw evidence
    groupBy:
      property: origin
      direction: ASC
    order:
      - file.name
      - title
      - type
      - origin
      - description
      - captured_at
      - source_url
      - authors
      - source_date
      - retrieved_at
      - tags
  - type: table
    name: Missing source details
    filters:
      and:
        - 'type == "source"'
        - or:
            - 'origin == "web"'
            - 'origin == "paper"'
            - 'origin == "book"'
        - '!source_url'
    order:
      - file.name
      - title
      - origin
      - description
      - source_url
      - retrieved_at
