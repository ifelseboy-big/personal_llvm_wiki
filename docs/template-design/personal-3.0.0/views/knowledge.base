filters:
  and:
    - 'file.inFolder("knowledge")'
    - 'file.ext == "md"'
formulas:
  review_state: 'if(review_after, if(date(review_after) <= today(), "overdue", "scheduled"), "")'
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  type:
    displayName: Type
  category:
    displayName: Category
  description:
    displayName: Description
  lifecycle:
    displayName: Lifecycle
  updated_at:
    displayName: Updated
  review_after:
    displayName: Review after
  formula.review_state:
    displayName: Review
  tags:
    displayName: Tags
views:
  - type: table
    name: Knowledge by category
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - title
      - category
      - type
      - description
      - lifecycle
      - updated_at
      - review_after
      - formula.review_state
      - tags
  - type: table
    name: All knowledge
    order:
      - file.name
      - title
      - category
      - type
      - lifecycle
      - description
      - valid_from
      - valid_until
      - review_after
      - updated_at
      - tags
