filters:
  and:
    - 'file.inFolder("knowledge")'
    - 'file.ext == "md"'
formulas:
  review_state: 'if(governance_version != "personal-1.2", "legacy", if(review_after, if(date(review_after) <= today(), "overdue", "scheduled"), ""))'
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  type:
    displayName: Type
  description:
    displayName: Description
  lifecycle:
    displayName: Lifecycle
  updated_at:
    displayName: Updated
  review_after:
    displayName: Review after
  formula.review_state:
    displayName: Review
  tags:
    displayName: Tags
views:
  - type: table
    name: Current knowledge
    filters:
      or:
        - '!governance_version'
        - and:
            - 'governance_version == "personal-1.2"'
            - 'lifecycle == "current"'
            - '!valid_from || date(valid_from) <= today()'
            - '!valid_until || date(valid_until) >= today()'
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - title
      - type
      - description
      - lifecycle
      - updated_at
      - review_after
      - formula.review_state
      - tags
  - type: table
    name: All knowledge
    order:
      - file.name
      - title
      - type
      - lifecycle
      - description
      - valid_from
      - valid_until
      - review_after
      - updated_at
      - tags
