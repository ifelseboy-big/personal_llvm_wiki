{
  "schema_version": 1,
  "name": "personal",
  "version": "2.0.2",
  "governance_version": "personal-2.0.0",
  "categories": [
    { "name": "development", "description": "需求、设计、工程决策、交付运行和研发复盘" },
    { "name": "learning", "description": "个人学习记录、概念理解、练习结论和知识边界" },
    { "name": "configuration", "description": "非敏感配置事实、影响范围、验证方法和安全引用位置" },
    { "name": "business", "description": "业务规则、业务流程、口径、角色和约束" }
  ],
  "types": [
    {
      "name": "plan",
      "description": "方案说明：要解决什么问题、准备怎么做、为什么这样选、如何验收",
      "template": "templates/knowledge/plan.md",
      "fields": [
        { "name": "plan_state", "kind": "enum", "required": true, "values": ["draft", "approved", "implemented", "rejected", "retired"] },
        { "name": "owner", "kind": "string" },
        { "name": "stakeholders", "kind": "string_list", "unique": true },
        { "name": "target_release", "kind": "string" },
        { "name": "applies_to", "kind": "string_list", "unique": true },
        { "name": "last_verified", "kind": "date" }
      ]
    },
    {
      "name": "guide",
      "description": "操作指南：谁在什么条件下按哪些步骤完成一件事，如何交接、检查与处理异常",
      "template": "templates/knowledge/guide.md",
      "fields": [
        { "name": "owner", "kind": "string" },
        { "name": "applies_to", "kind": "string_list", "unique": true },
        { "name": "last_verified", "kind": "date" }
      ]
    },
    {
      "name": "note",
      "description": "知识笔记：解释一个主题、概念或学习所得，保留例证、来源与适用边界",
      "template": "templates/knowledge/note.md",
      "fields": [
        { "name": "source_references", "kind": "string_list", "unique": true }
      ]
    },
    {
      "name": "config",
      "description": "配置说明：哪些非敏感设置控制什么行为，在哪里生效、如何验证与恢复",
      "template": "templates/knowledge/config.md",
      "fields": [
        { "name": "system", "kind": "string", "required": true },
        { "name": "environment", "kind": "string", "required": true },
        { "name": "last_verified", "kind": "date" },
        { "name": "security_reference", "kind": "string" }
      ]
    },
    {
      "name": "rule",
      "description": "规则说明：什么对象满足哪些条件时应得到什么结果，以及依据、例外与生效范围",
      "template": "templates/knowledge/rule.md",
      "fields": [
        { "name": "rule_state", "kind": "enum", "required": true, "values": ["draft", "active", "retired"] },
        { "name": "rule_owner", "kind": "string" },
        { "name": "effective_from", "kind": "date" },
        { "name": "effective_until", "kind": "date" }
      ]
    },
    {
      "name": "review",
      "description": "复盘总结：一个周期或事件的结果如何、为什么、下次保留或改变什么",
      "template": "templates/knowledge/review.md",
      "fields": [
        { "name": "period_start", "kind": "date", "required": true },
        { "name": "period_end", "kind": "date", "required": true },
        { "name": "participants", "kind": "string_list", "unique": true }
      ]
    }
  ],
  "knowledge": {
    "fields": [
      { "name": "category", "kind": "enum", "required": true, "values_from": "categories" },
      { "name": "description", "kind": "string", "required": true },
      { "name": "lifecycle", "kind": "enum", "required": true, "values": ["current", "disputed", "superseded", "retracted"] },
      { "name": "valid_from", "kind": "date" },
      { "name": "valid_until", "kind": "date" },
      { "name": "review_after", "kind": "date" }
    ],
    "relations": [
      { "field": "related", "default_for_create": true },
      { "field": "supersedes", "reciprocal": "superseded_by" },
      { "field": "superseded_by", "reciprocal": "supersedes" }
    ],
    "lifecycle": {
      "field": "lifecycle",
      "inactive_values": ["superseded", "retracted"],
      "disputed_values": ["disputed"],
      "valid_from_field": "valid_from",
      "valid_until_field": "valid_until",
      "review_after_field": "review_after",
      "exclude_not_yet_valid": true,
      "exclude_expired": true
    },
    "quality": {
      "require_h1_title": true,
      "reject_template_variables": true,
      "reject_prompt_comments": true,
      "require_complete_footnotes": true
    }
  },
  "workflows": [
    { "name": "capture", "path": "workflows/capture.md" },
    { "name": "organize", "path": "workflows/organize.md" },
    { "name": "publish", "path": "workflows/publish.md" },
    { "name": "maintain", "path": "workflows/maintain.md" },
    { "name": "query", "path": "workflows/query.md" }
  ]
}
