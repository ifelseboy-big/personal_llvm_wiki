{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/content-pack-v1.schema.json",
  "title": "llm-wiki declarative content pack v1",
  "type": "object",
  "required": ["schema_version", "name", "version", "governance_version", "categories", "types", "knowledge", "workflows"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "governance_version": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/named" } },
    "types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentType" } },
    "knowledge": { "$ref": "#/$defs/knowledge" },
    "workflows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflow" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "typeName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)|^[A-Za-z]:" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.(/|$)|//|/$" } }
      ]
    },
    "named": {
      "type": "object",
      "required": ["name", "description"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "description": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["field", "equals"],
      "properties": { "field": { "$ref": "#/$defs/name" }, "equals": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["string", "string_list", "enum", "date", "boolean", "integer"] },
        "required": { "type": "boolean" },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "values_from": { "const": "categories" },
        "unique": { "type": "boolean" },
        "required_when": { "$ref": "#/$defs/condition" }
      },
      "additionalProperties": false
    },
    "contentType": {
      "type": "object",
      "required": ["name", "description", "template", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "description": { "type": "string", "minLength": 1 },
        "template": { "$ref": "#/$defs/relativePath" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/name" },
        "reciprocal": { "$ref": "#/$defs/name" },
        "default_for_create": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["field", "inactive_values", "disputed_values"],
      "properties": {
        "field": { "$ref": "#/$defs/name" },
        "inactive_values": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "disputed_values": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "valid_from_field": { "$ref": "#/$defs/name" },
        "valid_until_field": { "$ref": "#/$defs/name" },
        "review_after_field": { "$ref": "#/$defs/name" },
        "exclude_not_yet_valid": { "type": "boolean" },
        "exclude_expired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["require_h1_title", "reject_template_variables", "reject_prompt_comments", "require_complete_footnotes"],
      "properties": {
        "require_h1_title": { "type": "boolean" },
        "reject_template_variables": { "type": "boolean" },
        "reject_prompt_comments": { "type": "boolean" },
        "require_complete_footnotes": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "required": ["fields", "relations", "quality"],
      "properties": {
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "quality": { "$ref": "#/$defs/quality" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["name", "path"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "path": { "$ref": "#/$defs/relativePath" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
