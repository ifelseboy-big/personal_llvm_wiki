{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/instance-v3.schema.json",
  "title": "llm-wiki instance v3",
  "type": "object",
  "required": ["schema_version", "instance_id", "name", "created_at", "template", "paths", "index", "security"],
  "properties": {
    "schema_version": { "const": 3 },
    "instance_id": { "type": "string", "pattern": "^wiki_[0-9a-hjkmnp-tv-z]{26}$" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "template": {
      "type": "object",
      "required": ["name", "version", "content_pack"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "content_pack": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["inbox", "knowledge", "templates", "rules", "runtime"],
      "properties": {
        "inbox": { "$ref": "#/$defs/relativePath" },
        "knowledge": { "$ref": "#/$defs/relativePath" },
        "templates": { "$ref": "#/$defs/relativePath" },
        "rules": { "$ref": "#/$defs/relativePath" },
        "runtime": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": ["chunk_max_chars", "chunk_overlap_chars", "chinese_tokenizer"],
      "properties": {
        "chunk_max_chars": { "type": "integer", "minimum": 256 },
        "chunk_overlap_chars": { "type": "integer", "minimum": 0 },
        "chinese_tokenizer": { "const": "simple" }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["follow_symlinks", "max_input_bytes", "block_sensitive_files"],
      "properties": {
        "follow_symlinks": { "const": false },
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "block_sensitive_files": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)|^[A-Za-z]:" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.(/|$)|//|/$" } }
      ]
    }
  },
  "additionalProperties": true
}
