{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/response-v2.schema.json",
  "title": "llm-wiki CLI response v2",
  "type": "object",
  "$defs": {
    "updateData": {
      "type": "object",
      "required": ["action", "path", "previous_version", "current_version", "dry_run"],
      "properties": {
        "action": { "enum": ["check", "current", "updated"] },
        "path": { "type": "string", "minLength": 1 },
        "previous_version": { "type": "string", "minLength": 1 },
        "current_version": { "type": "string", "minLength": 1 },
        "dry_run": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "ok", "command", "tool_version", "warnings", "affected_files"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "wiki": {
      "type": "object",
      "required": ["id", "name", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^wiki_[0-9a-hjkmnp-tv-z]{26}$" },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "data": true,
    "warnings": { "type": "array", "items": { "type": "string" } },
    "affected_files": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "meta": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "not": { "required": ["error"] } },
      "else": { "required": ["error"] }
    },
    {
      "if": {
        "properties": { "ok": { "const": true }, "command": { "const": "update" } },
        "required": ["ok", "command"]
      },
      "then": {
        "required": ["data"],
        "properties": { "data": { "$ref": "#/$defs/updateData" } }
      }
    }
  ],
  "additionalProperties": false
}
