{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/frontmatter-v1.schema.json",
  "title": "llm-wiki Markdown frontmatter v1",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rawId": { "type": "string", "pattern": "^raw_[0-9a-hjkmnp-tv-z]{26}$" },
    "knowledgeId": { "type": "string", "pattern": "^know_[0-9a-hjkmnp-tv-z]{26}$" },
    "derivedId": { "type": "string", "pattern": "^drv_[0-9a-hjkmnp-tv-z]{26}$" },
    "source": {
      "type": "object",
      "required": ["id", "content_hash"],
      "properties": {
        "id": { "$ref": "#/$defs/rawId" },
        "content_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Raw frontmatter",
      "type": "object",
      "required": ["schema_version", "id", "type", "title", "status", "origin", "captured_at", "content_hash", "media_type", "original_name"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/rawId" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "raw" },
        "origin": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "media_type": { "type": "string", "minLength": 1 },
        "original_name": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "Knowledge frontmatter",
      "type": "object",
      "required": ["schema_version", "id", "type", "title", "status", "sources", "published_at", "updated_at", "content_hash"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/knowledgeId" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "published" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "published_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    {
      "title": "Derived frontmatter",
      "type": "object",
      "required": ["schema_version", "id", "content_hash", "derived_from", "compiler", "compiler_version", "build_fingerprint", "generated_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/derivedId" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "derived_from": {
          "type": "object",
          "required": ["id", "content_hash"],
          "properties": {
            "id": { "$ref": "#/$defs/knowledgeId" },
            "content_hash": { "$ref": "#/$defs/hash" }
          },
          "additionalProperties": false
        },
        "compiler": { "type": "string", "minLength": 1 },
        "compiler_version": { "type": "integer", "minimum": 1 },
        "build_fingerprint": { "$ref": "#/$defs/hash" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
