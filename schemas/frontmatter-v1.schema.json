{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/frontmatter-v1.schema.json",
  "title": "llm-wiki Markdown frontmatter v1",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rawId": { "type": "string", "pattern": "^raw_[0-9a-hjkmnp-tv-z]{26}$" },
    "knowledgeId": { "type": "string", "pattern": "^know_[0-9a-hjkmnp-tv-z]{26}$" },
    "source": {
      "type": "object",
      "required": ["id", "content_hash"],
      "properties": {
        "id": { "$ref": "#/$defs/rawId" },
        "content_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Raw frontmatter",
      "type": "object",
      "required": ["schema_version", "id", "type", "title", "status", "origin", "captured_at", "content_hash", "media_type", "original_name"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/rawId" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "raw" },
        "origin": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "media_type": { "type": "string", "minLength": 1 },
        "original_name": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "source_url": { "type": "string" },
        "authors": { "$ref": "#/$defs/stringList" },
        "publisher": { "type": "string" },
        "source_date": { "type": "string", "format": "date" },
        "retrieved_at": { "type": "string", "format": "date" },
        "license": { "type": "string" },
        "language": { "type": "string" },
        "participants": { "$ref": "#/$defs/stringList" },
        "event_at": { "type": "string", "format": "date-time" },
        "tags": { "$ref": "#/$defs/stringList" },
        "aliases": { "$ref": "#/$defs/stringList" },
        "cssclasses": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": true
    },
    {
      "title": "Knowledge frontmatter",
      "type": "object",
      "required": ["schema_version", "id", "type", "title", "status", "sources", "published_at", "updated_at", "content_hash", "governance_version", "description", "lifecycle"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/knowledgeId" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "published" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "published_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "governance_version": { "const": "personal-1.3" },
        "description": { "type": "string" },
        "lifecycle": { "enum": ["current", "disputed", "superseded", "retracted"] },
        "valid_from": {
          "type": "string", "format": "date"
        },
        "valid_until": {
          "type": "string", "format": "date"
        },
        "review_after": {
          "type": "string", "format": "date"
        },
        "tags": { "$ref": "#/$defs/stringList" },
        "aliases": { "$ref": "#/$defs/stringList" },
        "cssclasses": { "$ref": "#/$defs/stringList" },
        "related": { "$ref": "#/$defs/stringList" },
        "supersedes": { "$ref": "#/$defs/stringList" },
        "superseded_by": { "$ref": "#/$defs/stringList" },
        "applies_to": { "$ref": "#/$defs/stringList" },
        "last_verified": { "type": "string", "format": "date" },
        "learning_outcome": { "type": "string" },
        "estimated_time": { "type": "string" },
        "reference_version": { "type": "string" },
        "decision_state": { "enum": ["proposed", "accepted", "deprecated"] },
        "decided_at": {
          "type": "string", "format": "date"
        },
        "decision_makers": { "$ref": "#/$defs/stringList" },
        "consulted": { "$ref": "#/$defs/stringList" },
        "informed": { "$ref": "#/$defs/stringList" },
        "project_state": { "enum": ["active", "paused", "completed", "cancelled"] },
        "as_of": { "type": "string", "format": "date" },
        "owner": { "type": "string" },
        "started_at": { "type": "string", "format": "date" },
        "target_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    }
  ]
}
