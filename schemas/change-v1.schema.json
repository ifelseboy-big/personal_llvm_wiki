{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/change-v1.schema.json",
  "title": "llm-wiki publication proposal v1",
  "type": "object",
  "required": ["schema_version", "id", "created_at", "sources", "knowledge_id", "target_path", "new_content_hash", "file_hash", "draft_file"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^chg_[0-9a-hjkmnp-tv-z]{26}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "content_hash"],
        "properties": {
          "id": { "type": "string", "pattern": "^raw_[0-9a-hjkmnp-tv-z]{26}$" },
          "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "knowledge_id": { "type": "string", "pattern": "^know_[0-9a-hjkmnp-tv-z]{26}$" },
    "target_path": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)|^[A-Za-z]:" }
    },
    "base_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "base_file_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "new_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "draft_file": { "const": "files/document.md" }
  },
  "additionalProperties": false
}
