{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/instance-v1.schema.json",
  "title": "llm-wiki.toml semantic model v1",
  "type": "object",
  "required": ["schema_version", "instance_id", "name", "created_at", "template", "paths", "publish", "index", "security"],
  "properties": {
    "schema_version": { "const": 1 },
    "instance_id": { "type": "string", "pattern": "^wiki_[0-9a-hjkmnp-tv-z]{26}$" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "template": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": true
    },
    "paths": {
      "type": "object",
      "required": ["raw", "knowledge", "derived", "templates", "rules", "runtime"],
      "properties": {
        "raw": { "$ref": "#/$defs/relativePath" },
        "knowledge": { "$ref": "#/$defs/relativePath" },
        "derived": { "$ref": "#/$defs/relativePath" },
        "templates": { "$ref": "#/$defs/relativePath" },
        "rules": { "$ref": "#/$defs/relativePath" },
        "runtime": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": true
    },
    "publish": {
      "type": "object",
      "required": ["require_sources"],
      "properties": { "require_sources": { "const": true } },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": ["chunk_max_chars", "chunk_overlap_chars", "chinese_tokenizer"],
      "properties": {
        "chunk_max_chars": { "type": "integer", "minimum": 256 },
        "chunk_overlap_chars": { "type": "integer", "minimum": 0 },
        "chinese_tokenizer": { "const": "unicode-han" }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": ["follow_symlinks", "max_input_bytes", "block_sensitive_files"],
      "properties": {
        "follow_symlinks": { "const": false },
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "block_sensitive_files": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)|^[A-Za-z]:" }
    }
  },
  "additionalProperties": true
}
