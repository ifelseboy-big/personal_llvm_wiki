{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.dev/schemas/frontmatter.schema.json",
  "title": "llm-wiki Markdown frontmatter",
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inboxId": { "type": "string", "pattern": "^inbox_[0-9a-hjkmnp-tv-z]{26}$" },
    "knowledgeId": { "type": "string", "pattern": "^know_[0-9a-hjkmnp-tv-z]{26}$" },
    "lineage": {
      "type": "object",
      "required": ["inbox_id", "payload_hash", "source", "captured_at"],
      "properties": {
        "inbox_id": { "$ref": "#/$defs/inboxId" },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "source": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Inbox item",
      "description": "Editable note; identity is independent of its filename. Stored versions and capture hashes do not gate publication; current hashes come from inbox show.",
      "type": "object",
      "required": ["id", "title", "status", "source", "captured_at", "media_type", "original_name"],
      "properties": {
        "schema_version": { "type": "integer" },
        "id": { "$ref": "#/$defs/inboxId" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "processed"] },
        "source": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "description": "Preserved capture metadata; not checked against the current body." },
        "media_type": { "type": "string", "minLength": 1 },
        "original_name": { "type": "string", "minLength": 1 },
        "payload": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$", "description": "Optional attachment path relative to the note directory, contained within Inbox. Omit for a self-contained note."},
        "payload_hash": { "type": "string", "description": "Preserved capture metadata; not checked against the current attachment." },
        "payload_bytes": { "type": "integer", "description": "Preserved capture metadata; not checked against the current attachment size." },
        "processed_at": { "type": "string", "format": "date-time" },
        "knowledge_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/knowledgeId" }, "uniqueItems": true },
        "tags": { "$ref": "#/$defs/stringList" },
        "aliases": { "$ref": "#/$defs/stringList" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "processed" } }, "required": ["status"] },
          "then": { "required": ["processed_at", "knowledge_ids"] },
          "else": { "not": { "anyOf": [{ "required": ["processed_at"] }, { "required": ["knowledge_ids"] }] } }
        }
      ],
      "additionalProperties": true
    },
    {
      "title": "Knowledge",
      "description": "Content fields are validated by the instance-bound content pack policy.",
      "type": "object",
      "required": ["schema_version", "id", "type", "title", "status", "lineage", "published_at", "updated_at", "content_hash", "governance_version"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/knowledgeId" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "published" },
        "lineage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lineage" } },
        "published_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "governance_version": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/stringList" },
        "aliases": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": true
    }
  ]
}
